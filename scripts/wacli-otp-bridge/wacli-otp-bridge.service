# Intellacc WhatsApp OTP bridge — host-side wacli send gateway.
# Installed as a USER service (Linger=yes on this host, no sudo needed):
#   cp scripts/wacli-otp-bridge/wacli-otp-bridge.env.example ~/.config/wacli-otp-bridge.env  # fill the token, chmod 600
#   cp scripts/wacli-otp-bridge/wacli-otp-bridge.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now wacli-otp-bridge
[Unit]
Description=Intellacc wacli OTP bridge (host-side WhatsApp send gateway)
After=network.target

[Service]
Type=simple
EnvironmentFile=%h/.config/wacli-otp-bridge.env
ExecStart=/home/jay/.nvm/versions/node/v24.14.0/bin/node /var/opt/docker/intellacc.com/scripts/wacli-otp-bridge/bridge.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

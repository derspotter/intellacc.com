# ~/.config/wacli-otp-bridge.env — config for the wacli-otp-bridge user
# service (chmod 600). Generate the token with: openssl rand -hex 32
# The SAME token goes into backend/.env as WACLI_BRIDGE_TOKEN.
BRIDGE_TOKEN=CHANGE-ME
# Unix socket, bind-mounted into the backend container (see backend/docker-compose.yml).
# Preferred transport: the host firewall drops docker->host TCP.
BRIDGE_SOCKET=/home/jay/.local/state/wacli-otp-bridge/bridge.sock
# Optional TCP listener for host-local curl tests
BRIDGE_BIND=127.0.0.1
BRIDGE_PORT=8790
WACLI_BIN=/home/jay/.local/bin/wacli
MAX_PER_NUMBER_PER_HOUR=3
MAX_GLOBAL_PER_DAY=100
MIN_SEND_GAP_MS=2000
